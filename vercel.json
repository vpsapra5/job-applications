{
  "functions": {
    "api/index.js": {
      "includeFiles": "tailored_resumes_*/**,original resume/**,*.pdf,*.docx,app/**,applied_jobs.json"
    }
  },
  "rewrites": [
    { "source": "/files/(.*)", "destination": "/api/index.js?file=$1" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 20 * * *"
    }
  ]
}
